# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used to build auth email redirect links. Optional in local dev
# (defaults to the request Host). Set it in production, e.g.
# https://acadence.example.edu.ng
NEXT_PUBLIC_SITE_URL=

# Server-only values. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Phase 11) — https://resend.com
RESEND_API_KEY=

# AI learning assistant (Phase 13). Server-side only.
OPENAI_API_KEY=
